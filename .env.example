# Copy to .env and edit. Nothing here is required for local development.

PORT=8787
# Public URL of THIS engine (used to build image URLs and for cookie flags).
PUBLIC_BASE_URL=http://localhost:8787

# Admin login. If unset, a random password is generated and printed at startup.
ADMIN_PASSWORD=
# Signs session cookies. If unset, one is generated and stored in DATA_DIR.
SESSION_SECRET=

# Where the blog page lives (used by the admin live preview iframe).
SITE_URL=http://localhost:5500/blog.html
# Origins allowed to read the public API from a browser (comma separated).
# Leave empty to allow any origin (fine: the public API only serves published posts).
SITE_ORIGINS=

# Extra HTTPS hosts allowed for image URLs (uploads from this engine are always allowed).
IMAGE_HOSTS=images.unsplash.com

DATA_DIR=./data
MAX_UPLOAD_MB=5
# Set to 1 only when running behind a reverse proxy you control (uses X-Forwarded-For for rate limits).
TRUST_PROXY=0
